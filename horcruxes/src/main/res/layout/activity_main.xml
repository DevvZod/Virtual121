<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A07"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="H O R C R U X E S"
        android:textColor="#33FF66"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Soul-split container — 7 fragments bound."
        android:textColor="#5F7A65"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnBindInstalled"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="#33FF66"
        android:text="＋  ADD APP (INSTALLED)"
        android:textColor="#04120A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnInstallApk"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="#0C130D"
        android:text="＋  ADD APP (FROM APK FILE)"
        android:textColor="#33FF66"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnModules"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="#0C130D"
        android:text="MODULES"
        android:textColor="#33FF66"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStorage"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="#0C130D"
        android:text="STORAGE ACCESS"
        android:textColor="#33FF66"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="BOUND SOULS (long-press to release)"
        android:textColor="#5F7A65"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/soulsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
